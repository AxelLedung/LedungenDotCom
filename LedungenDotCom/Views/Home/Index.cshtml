@{
    ViewData["Title"] = "Home Page";
}


<main role="main" class="pb-5">
    <section class="modal-title mb-4">
        <div class="container">
            <div class="text-center">
                <h1>Welcome to my web application!</h1>
            </div>
        </div>
    </section>

    <div class="container">
        <section id="current-implementation" class="modal-body mb-4">
            <div class="container">
                <div class="text">
                    <h2>Current implementation</h2>
                    <p>Homepage</p>
                    <p>Navbar</p>
                    <p>Database Connection</p>
                </div>
            </div>
        </section>
        <section id="recent-updates" class="modal-body mb-4">
            <div class="container">
                <div class="text">
                    <h2>Recently added updates</h2>
                    <p>Nothing new</p>
                </div>
            </div>
        </section>
        <section id="planned-implementation" class="modal-body">
            <div class="container">
                <div class="text">
                    <h2>Planned implementations</h2>
                    <p>AI chatbot</p>
                    <p>Contact form</p>
                    <p>Interactive embedding of my projects</p>
                    <p>Example code of previous solutions I am proud of.</p>
                </div>
            </div>
        </section>
    </div>
</main>